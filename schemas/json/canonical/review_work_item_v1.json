{
  "$id": "urn:aic:b1.2:schema:REVIEW_WORK_ITEM_V1:v0.2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string",
      "x-aic-require-aware-utc": true
    },
    "created_from_thesis_event_id": {
      "minLength": 1,
      "type": "string"
    },
    "decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner_acknowledged_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string",
          "x-aic-require-aware-utc": true
        },
        {
          "type": "null"
        }
      ]
    },
    "priority": {
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH",
        "BLOCKING"
      ],
      "type": "string"
    },
    "reevaluation_run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "resolved_by_decision_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_work_item_id": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "OPEN",
        "ACKNOWLEDGED",
        "REEVALUATION_STARTED",
        "RESOLVED",
        "SUPERSEDED"
      ],
      "type": "string"
    },
    "work_item_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "review_work_item_id",
    "decision_id",
    "candidate_id",
    "created_from_thesis_event_id",
    "status",
    "priority",
    "created_at",
    "owner_acknowledged_at",
    "reevaluation_run_id",
    "resolved_by_decision_id",
    "work_item_hash"
  ],
  "title": "REVIEW_WORK_ITEM_V1",
  "type": "object",
  "x-aic-canonical-hash-field": "work_item_hash",
  "x-aic-canonical-id-field": "review_work_item_id",
  "x-aic-canonical-name": "REVIEW_WORK_ITEM_V1",
  "x-aic-contract-version": "0.2",
  "x-aic-field-authority": "MACHINE_CLOSED_V0_2",
  "x-aic-fixed-field-presence": true,
  "x-aic-implementation-rule": "Pydantic implementation MUST conform to this schema; prose is not field authority.",
  "x-aic-journal-payload-schema": "aic.review_work_item.v1",
  "x-aic-persistence-class": "DURABLE_CANONICAL",
  "x-aic-presence-normalization": "ALL_TOP_LEVEL_FIELDS_PRESENT; SOURCE_OPTIONAL_OR_IF_AVAILABLE_VALUES_ARE_EXPLICIT_NULL",
  "x-aic-self-hash-field": "work_item_hash",
  "x-aic-self-hash-rule": "SHA256(B1_CANONICAL_SERIALIZATION(object excluding own self-hash field only))",
  "x-aic-source-refs": [
    "P-B7_IMPLEMENTATION_PACKET_v0.1:§21",
    "P-B7_WORKFLOW_AND_MONITOR_RECONCILIATION_AMENDMENT_v0.5:§9",
    "CANONICAL_MANIFEST_v0.5:M054"
  ]
}
