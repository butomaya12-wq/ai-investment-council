{
  "$id": "urn:aic:b1.2:schema:OWNER_ACCOUNT_V1:v0.2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "all_sessions_revoked_after": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string",
          "x-aic-require-aware-utc": true
        },
        {
          "type": "null"
        }
      ]
    },
    "auth_version": {
