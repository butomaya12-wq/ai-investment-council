{
  "$id": "urn:aic:b1.2:schema:THESIS_EVENT_V1:v0.3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "produced_by": {
            "const": "MONITOR"
          }
        },
        "required": [
          "produced_by"
        ]
      },
      "then": {
        "properties": {
          "effect": {
            "enum": [
              "NO_CHANGE",
              "REVIEW_REQUIRED",
              "THESIS_INVALIDATED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "produced_by": {
            "const": "REEVALUATION"
          }
        },
        "required": [
          "produced_by"
        ]
      },
      "then": {
        "properties": {
          "effect": {
            "enum": [
              "NO_CHANGE",
              "REVIEW_REQUIRED",
              "THESIS_STRENGTHENED",
              "THESIS_WEAKENED",
              "THESIS_INVALIDATED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effect": {
            "enum": [
              "THESIS_STRENGTHENED",
              "THESIS_WEAKENED",
              "THESIS_INVALIDATED"
            ]
          }
        },
        "required": [
          "effect"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "new_decision_id": {
                "minLength": 1,
                "type": "string"
              },
              "produced_by": {
                "const": "REEVALUATION"
              }
            }
          },
          {
            "properties": {
              "effect": {
                "const": "THESIS_INVALIDATED"
              },
              "produced_by": {
                "const": "MONITOR"
              }
            }
          }
        ]
      }
    }
  ],
  "properties": {
    "candidate_id": {
      "minLength": 1,
      "type": "string"
    },
    "conflict_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "effect": {
      "enum": [
        "NO_CHANGE",
        "REVIEW_REQUIRED",
        "THESIS_STRENGTHENED",
        "THESIS_WEAKENED",
        "THESIS_INVALIDATED"
      ],
      "type": "string"
    },
    "event_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "execution_authority": {
      "const": false,
      "type": "boolean"
    },
    "matched_invalidation_condition_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "monitor_policy_ref": {
      "$ref": "urn:aic:b1.2:schema:POLICY_REFERENCE_V1:v0.2"
    },
    "new_decision_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "format": "date-time",
      "type": "string",
      "x-aic-require-aware-utc": true
    },
    "priority": {
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH",
        "BLOCKING"
      ],
      "type": "string"
    },
    "produced_by": {
      "enum": [
        "MONITOR",
        "REEVALUATION"
      ],
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "review_work_item_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_event_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "thesis_event_id": {
      "minLength": 1,
      "type": "string"
    },
    "triage_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "trigger_type": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "thesis_event_id",
    "decision_id",
    "candidate_id",
    "trigger_type",
    "source_event_ids",
    "observed_at",
    "matched_invalidation_condition_refs",
    "evidence_ids",
    "conflict_ids",
    "effect",
    "priority",
    "reason_codes",
    "triage_ref",
    "review_work_item_id",
    "produced_by",
    "monitor_policy_ref",
    "new_decision_id",
    "event_hash",
    "execution_authority"
  ],
  "title": "THESIS_EVENT_V1",
  "type": "object",
  "x-aic-canonical-hash-field": "event_hash",
  "x-aic-canonical-id-field": "thesis_event_id",
  "x-aic-canonical-name": "THESIS_EVENT_V1",
  "x-aic-contextual-validator-refs": [
    {
      "applies_when": {
        "effect": "THESIS_INVALIDATED",
        "produced_by": "MONITOR"
      },
      "required_result": "PASS",
      "source": "P-B7_WORKFLOW_AND_MONITOR_RECONCILIATION_AMENDMENT_v0.5:I01-I10",
      "validator_id": "DETERMINISTIC_FROZEN_INVALIDATION_TRUE_V1"
    }
  ],
  "x-aic-contract-version": "0.3",
  "x-aic-field-authority": "MACHINE_CLOSED_V0_3",
  "x-aic-fixed-field-presence": true,
  "x-aic-implementation-rule": "Pydantic/runtime bindings MUST conform to this exact accepted schema resource; candidate self-hashes/prose cannot override the external registry baseline.",
  "x-aic-journal-payload-schema": "aic.thesis_event.v1",
  "x-aic-normalization-decision-ids": [
    "ND-S8-005"
  ],
  "x-aic-persistence-class": "DURABLE_CANONICAL",
  "x-aic-presence-normalization": "ALL_TOP_LEVEL_FIELDS_PRESENT; SOURCE_OPTIONAL_OR_IF_AVAILABLE_VALUES_ARE_EXPLICIT_NULL",
  "x-aic-registry-baseline-required": true,
  "x-aic-self-hash-field": "event_hash",
  "x-aic-self-hash-rule": "SHA256(B1_CANONICAL_SERIALIZATION(object excluding own self-hash field only))",
  "x-aic-semantic-validators": [
    {
      "id": "TE-V01",
      "rule": "produced_by=MONITOR => effect in {NO_CHANGE,REVIEW_REQUIRED,THESIS_INVALIDATED}; THESIS_INVALIDATED only if deterministic frozen I01..I10 predicate true"
    },
    {
      "id": "TE-V02",
      "rule": "produced_by=REEVALUATION => strengthened/weakened/invalidated requires valid new_decision_id lineage"
    },
    {
      "id": "THESIS_EVENT_V1-POLREF-V03",
      "rule": "Policy version strings are not authority; every replaced policy field is exact POLICY_REFERENCE_V1 per current M060."
    }
  ],
  "x-aic-source-refs": [
    "P-B7_THESIS_MONITOR_AND_REEVALUATION_CONTRACT_v0.2:§13",
    "P-B7_WORKFLOW_AND_MONITOR_RECONCILIATION_AMENDMENT_v0.5:§2-§3",
    "CANONICAL_MANIFEST_v0.5:M053"
  ]
}
