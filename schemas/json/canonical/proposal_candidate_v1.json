{
  "$id": "urn:aic:b1.2:schema:PROPOSAL_CANDIDATE_V1:v0.2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset": {
      "minLength": 1,
      "type": "string"
    },
    "candidate_id": {
      "minLength": 1,
      "type": "string"
    },
    "canonical_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string",
      "x-aic-require-aware-utc": true
    },
    "decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "environment": {
      "const": "PAPER",
      "type": "string"
    },
    "extended_hours": {
      "const": false,
      "type": "boolean"
    },
    "final_decision_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "mandate_version": {
      "minLength": 1,
      "type": "string"
    },
    "notional_usd": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string",
      "x-aic-no-exponent": true,
      "x-aic-python-type": "decimal.Decimal"
    },
    "order_type": {
      "const": "MARKET",
      "type": "string"
    },
    "policy_lineage_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "policy_refs": {
      "$ref": "urn:aic:b1.2:schema:PolicyRefs10:v0.2"
    },
    "proposal_candidate_id": {
      "minLength": 1,
      "type": "string"
    },
    "risk_input_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "risk_input_snapshot_id": {
      "minLength": 1,
      "type": "string"
    },
    "side": {
      "const": "BUY",
      "type": "string"
    },
    "sizing_computation_id": {
      "minLength": 1,
      "type": "string"
    },
    "time_in_force": {
      "const": "DAY",
      "type": "string"
    }
  },
  "required": [
    "proposal_candidate_id",
    "decision_id",
    "final_decision_hash",
    "candidate_id",
    "asset",
    "side",
    "order_type",
    "time_in_force",
    "extended_hours",
    "environment",
    "notional_usd",
    "sizing_computation_id",
    "risk_input_snapshot_id",
    "risk_input_snapshot_hash",
    "mandate_version",
    "policy_refs",
    "policy_lineage_hash",
    "canonical_payload_hash",
    "created_at"
  ],
  "title": "PROPOSAL_CANDIDATE_V1",
  "type": "object",
  "x-aic-canonical-hash-field": "canonical_payload_hash",
  "x-aic-canonical-id-field": "proposal_candidate_id",
  "x-aic-canonical-name": "PROPOSAL_CANDIDATE_V1",
  "x-aic-contract-version": "0.2",
  "x-aic-field-authority": "MACHINE_CLOSED_V0_2",
  "x-aic-fixed-field-presence": true,
  "x-aic-implementation-rule": "Pydantic implementation MUST conform to this schema; prose is not field authority.",
  "x-aic-journal-payload-schema": "aic.proposal_candidate.v1",
  "x-aic-persistence-class": "DURABLE_CANONICAL",
  "x-aic-presence-normalization": "ALL_TOP_LEVEL_FIELDS_PRESENT; SOURCE_OPTIONAL_OR_IF_AVAILABLE_VALUES_ARE_EXPLICIT_NULL",
  "x-aic-self-hash-field": "canonical_payload_hash",
  "x-aic-self-hash-rule": "SHA256(B1_CANONICAL_SERIALIZATION(object excluding own self-hash field only))",
  "x-aic-semantic-validators": [
    {
      "id": "PC-V01",
      "rule": "legacy b4_decision_id and version-only policy authority are not canonical; exact FinalDecision and policy_refs required"
    }
  ],
  "x-aic-source-refs": [
    "P-B5_IMPLEMENTATION_PACKET_v0.1:§9",
    "P-B5_B6_ACCEPTED_PROPOSAL_HANDOFF_AMENDMENT_v0.5:§4",
    "CANONICAL_MANIFEST_v0.5:M030"
  ]
}
