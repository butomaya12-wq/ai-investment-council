{
  "$id": "urn:aic:b1.2:schema:FINAL_DECISION_V1:v0.2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "INVEST"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "evidence_status": {
            "enum": [
              "COMPLETE",
              "PARTIAL"
            ]
          },
          "primary_candidate_id": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ABSTAIN"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "primary_candidate_id": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "b2_data_snapshot_id": {
      "minLength": 1,
      "type": "string"
    },
    "blocking_reason_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "type": "string",
      "x-aic-require-aware-utc": true
    },
    "decision_change_condition_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "decision_lifecycle_policy_ref": {
      "$ref": "urn:aic:b1.2:schema:POLICY_REFERENCE_V1:v0.2"
    },
    "decision_ttl": {
      "$ref": "urn:aic:b1.2:schema:DECISION_TTL_V1:v0.2"
    },
    "deep_comparison_id": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "INSUFFICIENT"
      ],
      "type": "string"
    },
    "final_decision_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "invalidation_condition_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "judge_input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "mandate_version": {
      "minLength": 1,
      "type": "string"
    },
    "material_conflict_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "material_unknown_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "model_run_ref": {
      "minLength": 1,
      "type": "string"
    },
    "next_review_trigger": {
      "$ref": "urn:aic:b1.2:schema:NEXT_REVIEW_TRIGGER_V1:v0.2"
    },
    "outcome": {
      "enum": [
        "INVEST",
        "WATCH",
        "ABSTAIN"
      ],
      "type": "string"
    },
    "policy_lineage_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "policy_refs": {
      "$ref": "urn:aic:b1.2:schema:PolicyRefs8:v0.2"
    },
    "primary_candidate_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "research_snapshot_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "risk_result_id": {
      "type": "null"
    },
    "selected_candidate_basis_claim_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "unresolved_dispute_claim_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "watch_candidate_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "why_not_other_candidates": {
      "items": {
        "$ref": "urn:aic:b1.2:schema:WhyNotCandidate:v0.2"
      },
      "type": "array"
    }
  },
  "required": [
    "decision_id",
    "outcome",
    "primary_candidate_id",
    "watch_candidate_ids",
    "mandate_version",
    "b2_data_snapshot_id",
    "research_snapshot_ids",
    "deep_comparison_id",
    "created_at",
    "decision_lifecycle_policy_ref",
    "decision_ttl",
    "next_review_trigger",
    "policy_refs",
    "policy_lineage_hash",
    "judge_input_hash",
    "selected_candidate_basis_claim_ids",
    "why_not_other_candidates",
    "unresolved_dispute_claim_ids",
    "material_conflict_refs",
    "material_unknown_refs",
    "blocking_reason_codes",
    "invalidation_condition_ids",
    "decision_change_condition_ids",
    "evidence_status",
    "model_run_ref",
    "risk_result_id",
    "final_decision_hash"
  ],
  "title": "FINAL_DECISION_V1",
  "type": "object",
  "x-aic-canonical-hash-field": "final_decision_hash",
  "x-aic-canonical-id-field": "decision_id",
  "x-aic-canonical-name": "FINAL_DECISION_V1",
  "x-aic-contract-version": "0.2",
  "x-aic-field-authority": "MACHINE_CLOSED_V0_2",
  "x-aic-fixed-field-presence": true,
  "x-aic-implementation-rule": "Pydantic implementation MUST conform to this schema; prose is not field authority.",
  "x-aic-journal-payload-schema": "aic.final_decision.v1",
  "x-aic-persistence-class": "DURABLE_CANONICAL",
  "x-aic-presence-normalization": "ALL_TOP_LEVEL_FIELDS_PRESENT; SOURCE_OPTIONAL_OR_IF_AVAILABLE_VALUES_ARE_EXPLICIT_NULL",
  "x-aic-self-hash-field": "final_decision_hash",
  "x-aic-self-hash-rule": "SHA256(B1_CANONICAL_SERIALIZATION(object excluding own self-hash field only))",
  "x-aic-semantic-validators": [
    {
      "id": "FD-V01",
      "rule": "created_at equals source DECISION_DRAFT_B4_v0_4.created_at canonical-identically"
    },
    {
      "id": "FD-V02",
      "rule": "decision_lifecycle_policy_ref == policy_refs.decision_lifecycle_policy"
    },
    {
      "id": "FD-V03",
      "rule": "policy_lineage_hash = SHA256(canonical sorted policy_refs map)"
    },
    {
      "id": "FD-V04",
      "rule": "outcome=INVEST => primary_candidate_id!=null AND evidence_status!=INSUFFICIENT AND no unresolved blocking reason"
    },
    {
      "id": "FD-V05",
      "rule": "outcome=ABSTAIN => primary_candidate_id=null"
    },
    {
      "id": "FD-V06",
      "rule": "risk_policy and sizing_policy are absent from policy_refs"
    }
  ],
  "x-aic-source-refs": [
    "P-B4_CLAIM_AND_FINAL_DECISION_PROMOTION_AMENDMENT_v0.5:§7,§9,§14",
    "CANONICAL_MANIFEST_v0.5:M023"
  ]
}
