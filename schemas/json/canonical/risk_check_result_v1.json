{
  "$id": "urn:aic:b1.2:schema:RISK_CHECK_RESULT_V1:v0.2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "check_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "check_id": {
      "minLength": 1,
      "type": "string"
    },
    "check_result_id": {
      "minLength": 1,
      "type": "string"
    },
    "computed_value_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "evaluated_at": {
      "format": "date-time",
      "type": "string",
      "x-aic-require-aware-utc": true
    },
    "input_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "max_allowed_notional_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_value_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_limit_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "required": {
      "type": "boolean"
    },
    "risk_result_id": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "MODIFY",
        "BLOCK",
        "INCOMPLETE_DATA",
        "NOT_APPLICABLE"
      ],
      "type": "string"
    }
  },
  "required": [
    "check_result_id",
    "risk_result_id",
    "check_id",
    "status",
    "required",
    "input_refs",
    "computed_value_ids",
    "policy_limit_ref",
    "observed_value_ref",
    "max_allowed_notional_ref",
    "reason_codes",
    "evaluated_at",
    "check_hash"
  ],
  "title": "RISK_CHECK_RESULT_V1",
  "type": "object",
  "x-aic-canonical-hash-field": "check_hash",
  "x-aic-canonical-id-field": "check_result_id",
  "x-aic-canonical-name": "RISK_CHECK_RESULT_V1",
  "x-aic-contract-version": "0.2",
  "x-aic-field-authority": "MACHINE_CLOSED_V0_2",
  "x-aic-fixed-field-presence": true,
  "x-aic-implementation-rule": "Pydantic implementation MUST conform to this schema; prose is not field authority.",
  "x-aic-journal-payload-schema": "aic.risk_check_result.v1",
  "x-aic-persistence-class": "DURABLE_CANONICAL",
  "x-aic-presence-normalization": "ALL_TOP_LEVEL_FIELDS_PRESENT; SOURCE_OPTIONAL_OR_IF_AVAILABLE_VALUES_ARE_EXPLICIT_NULL",
  "x-aic-self-hash-field": "check_hash",
  "x-aic-self-hash-rule": "SHA256(B1_CANONICAL_SERIALIZATION(object excluding own self-hash field only))",
  "x-aic-semantic-validators": [
    {
      "id": "RCR-V01",
      "rule": "status=NOT_APPLICABLE is legal only for optional/disabled check declared before run"
    }
  ],
  "x-aic-source-refs": [
    "P-B5_IMPLEMENTATION_PACKET_v0.1:§17",
    "CANONICAL_MANIFEST_v0.5:M031"
  ]
}
