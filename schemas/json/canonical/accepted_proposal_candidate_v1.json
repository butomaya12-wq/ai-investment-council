  "title": "ACCEPTED_PROPOSAL_CANDIDATE_V1",
  "type": "object",
  "x-aic-canonical-hash-field": "accepted_hash",
  "x-aic-canonical-id-field": "accepted_proposal_id",
  "x-aic-canonical-name": "ACCEPTED_PROPOSAL_CANDIDATE_V1",
  "x-aic-contract-version": "0.2",
  "x-aic-field-authority": "MACHINE_CLOSED_V0_2",
  "x-aic-fixed-field-presence": true,
  "x-aic-implementation-rule": "Pydantic implementation MUST conform to this schema; prose is not field authority.",
  "x-aic-journal-payload-schema": "aic.accepted_proposal_candidate.v1",
  "x-aic-persistence-class": "DURABLE_CANONICAL",
  "x-aic-presence-normalization": "ALL_TOP_LEVEL_FIELDS_PRESENT; SOURCE_OPTIONAL_OR_IF_AVAILABLE_VALUES_ARE_EXPLICIT_NULL",
  "x-aic-self-hash-field": "accepted_hash",
  "x-aic-self-hash-rule": "SHA256(B1_CANONICAL_SERIALIZATION(object excluding own self-hash field only))",
  "x-aic-semantic-validators": [
    {
      "id": "APC-V01",
      "rule": "policy_refs has exact 10-key set including decision_lifecycle_policy,risk_policy,sizing_policy"
    },
    {
      "id": "APC-V02",
      "rule": "pass RiskResult, PortfolioImpact, snapshot, FinalDecision and ProposalCandidate IDs/hashes form one exact lineage"
    }
  ],
  "x-aic-source-refs": [
    "P-B5_B6_ACCEPTED_PROPOSAL_HANDOFF_AMENDMENT_v0.5:§3,§11",
    "CANONICAL_MANIFEST_v0.5:M034"
  ]
}
