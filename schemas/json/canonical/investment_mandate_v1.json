      "type": "string"
    },
    "mandate_id": {
      "minLength": 1,
      "type": "string"
    },
    "max_single_name_policy_ref": {
      "minLength": 1,
      "type": "string"
    },
    "objective": {
      "minLength": 1,
      "type": "string"
    },
    "owner_id": {
      "minLength": 1,
      "type": "string"
    },
    "risk_budget_policy_ref": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
