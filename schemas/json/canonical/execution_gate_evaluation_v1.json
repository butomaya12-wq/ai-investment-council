          "gate_family"
        ]
      },
      "then": {
        "properties": {
          "commit_risk_result_hash": {
            "type": "null"
          },
          "commit_risk_result_id": {
            "type": "null"
          },
          "commit_snapshot_hash": {
            "type": "null"
          },
          "commit_snapshot_id": {
            "type": "null"
          },
          "pre_submit_snapshot_hash": {
            "$ref": "urn:aic:b1.2:schema:Hash256:v0.2"
          },
          "pre_submit_snapshot_id": {
            "minLength": 1,
            "type": "string"
          },
          "prepare_risk_result_hash": {
            "$ref": "urn:aic:b1.2:schema:Hash256:v0.2"
          },
          "prepare_risk_result_id": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
