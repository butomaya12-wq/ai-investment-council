          },
          "commit_snapshot_hash": {
            "$ref": "urn:aic:b1.2:schema:Hash256:v0.2"
          },
          "commit_snapshot_id": {
            "minLength": 1,
            "type": "string"
          },
          "intent_id": {
            "minLength": 1,
            "type": "string"
          },
          "lock_epoch": {
            "minimum": 0,
            "type": "integer"
          }
        }
      }
    }
  ],
  "properties": {
