      "minLength": 1,
      "type": "string"
    },
    "gate_family": {
      "enum": [
        "EA",
        "CA"
      ],
      "type": "string"
    },
    "gate_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "intent_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
