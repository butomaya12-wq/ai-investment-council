  "required": [
    "gate_evaluation_id",
    "gate_family",
    "proposal_id",
    "canonical_payload_hash",
    "approval_id",
    "envelope_hash",
    "accepted_proposal_id",
    "accepted_proposal_hash",
    "intent_id",
    "pre_submit_snapshot_id",
