{
  "$id": "urn:aic:b1.2:schema:RUN_ENVELOPE_V1:v0.2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data_snapshot_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "final_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "READY_FOR_REVIEW",
        "INCONCLUSIVE"
      ],
      "type": "string"
    },
    "harness_version": {
      "minLength": 1,
      "type": "string"
    },
    "mandate_version": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "model_policy_refs": {
      "additionalProperties": {
        "$ref": "urn:aic:b1.2:schema:POLICY_REFERENCE_V1:v0.2"
      },
      "type": "object"
    },
    "model_runtime": {
      "minLength": 1,
      "type": "string"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "permissions_profile": {
      "minLength": 1,
      "type": "string"
    },
    "product_git_commit": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reopen_request_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "type": "string",
      "x-aic-require-aware-utc": true
    },
    "workflow_version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "started_at",
    "workflow_version",
    "harness_version",
    "model_runtime",
    "mandate_version",
    "data_snapshot_id",
    "permissions_profile",
    "final_status",
    "parent_run_id",
    "reopen_request_id",
    "product_git_commit",
    "model_policy_refs",
    "run_hash"
  ],
  "title": "RUN_ENVELOPE_V1",
  "type": "object",
  "x-aic-canonical-hash-field": "run_hash",
  "x-aic-canonical-id-field": "run_id",
  "x-aic-canonical-name": "RUN_ENVELOPE_V1",
  "x-aic-context-validator-ref": "#/$defs/RUN_ENVELOPE_CONTEXT_VALIDATION_INPUT",
  "x-aic-context-vocabulary": {
    "data_retrieval_completed": {
      "description": "deterministic lifecycle fact from journal/state machine",
      "type": "boolean"
    },
    "workflow_state": {
      "description": "current canonical workflow state external to immutable run envelope",
      "type": "string"
    }
  },
  "x-aic-contract-version": "0.2",
  "x-aic-field-authority": "MACHINE_CLOSED_V0_2",
  "x-aic-fixed-field-presence": true,
  "x-aic-implementation-rule": "Pydantic implementation MUST conform to this schema; prose is not field authority.",
  "x-aic-journal-payload-schema": "aic.run_envelope.v1",
  "x-aic-opaque-substructures": {
    "paths": [
      "/model_policy_refs"
    ],
    "rule": "B1 validates container type only. No child-field business semantics may be inferred from this bundle; owning later-stage contract/payload_schema must define any child semantics before use."
  },
  "x-aic-persistence-class": "DURABLE_CANONICAL",
  "x-aic-presence-normalization": "ALL_TOP_LEVEL_FIELDS_PRESENT; SOURCE_OPTIONAL_OR_IF_AVAILABLE_VALUES_ARE_EXPLICIT_NULL",
  "x-aic-self-hash-field": "run_hash",
  "x-aic-self-hash-rule": "SHA256(B1_CANONICAL_SERIALIZATION(object excluding own self-hash field only))",
  "x-aic-semantic-validators": [
    {
      "id": "RUN-V03",
      "rule": "harness_version, model_runtime, permissions_profile and final_status are non-null required"
    }
  ],
  "x-aic-source-refs": [
    "Engineering_Spec_v0.5:RUN_ENVELOPE",
    "CANONICAL_MANIFEST_v0.5:M059",
    "P-B7_WORKFLOW_AND_MONITOR_RECONCILIATION_AMENDMENT_v0.5:§7"
  ]
}
