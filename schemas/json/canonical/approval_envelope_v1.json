{
  "$id": "urn:aic:b1.2:schema:APPROVAL_ENVELOPE_V1:v0.4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_proposal_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "accepted_proposal_id": {
      "minLength": 1,
      "type": "string"
    },
    "action_nonce_id": {
      "minLength": 1,
      "type": "string"
    },
    "approval_id": {
      "minLength": 1,
      "type": "string"
    },
    "approved_at": {
      "format": "date-time",
      "type": "string",
      "x-aic-require-aware-utc": true
    },
    "auth_version": {
      "minimum": 0,
      "type": "integer"
    },
    "authenticated_owner_id": {
      "minLength": 1,
      "type": "string"
    },
    "authenticated_session_or_signature_ref": {
      "minLength": 1,
      "type": "string"
    },
    "canonical_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT",
        "KEEP_WATCHING"
      ],
      "type": "string"
    },
    "decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "displayed_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "envelope_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string",
      "x-aic-require-aware-utc": true
    },
    "final_decision_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "mandate_version": {
      "minLength": 1,
      "type": "string"
    },
    "paper_account_id": {
      "minLength": 1,
      "type": "string"
    },
    "pass_risk_result_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "pass_risk_result_id": {
      "minLength": 1,
      "type": "string"
    },
    "policy_lineage_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "policy_refs": {
      "$ref": "urn:aic:b1.2:schema:PolicyRefs10:v0.2"
    },
    "proposal_id": {
      "minLength": 1,
      "type": "string"
    },
    "revoked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string",
          "x-aic-require-aware-utc": true
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "approval_id",
    "authenticated_owner_id",
    "authenticated_session_or_signature_ref",
    "session_id",
    "auth_version",
    "action_nonce_id",
    "proposal_id",
    "decision_id",
    "mandate_version",
    "final_decision_hash",
    "paper_account_id",
    "accepted_proposal_id",
    "accepted_proposal_hash",
    "canonical_payload_hash",
    "displayed_payload_hash",
    "pass_risk_result_id",
    "pass_risk_result_hash",
    "policy_refs",
    "policy_lineage_hash",
    "decision",
    "approved_at",
    "expires_at",
    "revoked_at",
    "envelope_hash"
