{
  "$id": "urn:aic:b1.2:schema:TRADE_PROPOSAL_V1:v0.2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_proposal_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "accepted_proposal_id": {
      "minLength": 1,
      "type": "string"
    },
    "asset": {
      "minLength": 1,
      "type": "string"
    },
    "b5_risk_input_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "b5_risk_input_snapshot_id": {
      "minLength": 1,
      "type": "string"
    },
    "canonical_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string",
      "x-aic-require-aware-utc": true
    },
    "decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "environment": {
      "const": "PAPER",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string",
      "x-aic-require-aware-utc": true
    },
    "extended_hours": {
      "const": false,
      "type": "boolean"
    },
    "final_decision_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "intent_id": {
      "minLength": 1,
      "type": "string"
    },
    "mandate_version": {
      "minLength": 1,
      "type": "string"
    },
    "notional_usd": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string",
      "x-aic-no-exponent": true,
      "x-aic-python-type": "decimal.Decimal"
    },
    "order_type": {
      "const": "MARKET",
      "type": "string"
    },
    "paper_account_id": {
      "minLength": 1,
      "type": "string"
    },
    "pass_risk_result_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "pass_risk_result_id": {
      "minLength": 1,
      "type": "string"
    },
    "policy_lineage_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "policy_refs": {
      "$ref": "urn:aic:b1.2:schema:PolicyRefs10:v0.2"
    },
    "portfolio_impact_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "portfolio_impact_id": {
      "minLength": 1,
      "type": "string"
    },
    "proposal_id": {
      "minLength": 1,
      "type": "string"
    },
    "side": {
      "const": "BUY",
      "type": "string"
    },
    "time_in_force": {
      "const": "DAY",
      "type": "string"
    }
  },
  "required": [
    "accepted_proposal_id",
    "accepted_proposal_hash",
    "proposal_id",
    "intent_id",
    "decision_id",
    "final_decision_hash",
    "asset",
    "side",
    "notional_usd",
    "order_type",
    "time_in_force",
    "extended_hours",
    "environment",
    "paper_account_id",
    "pass_risk_result_id",
    "pass_risk_result_hash",
    "portfolio_impact_id",
    "portfolio_impact_hash",
    "b5_risk_input_snapshot_id",
    "b5_risk_input_snapshot_hash",
    "mandate_version",
    "policy_refs",
    "policy_lineage_hash",
    "created_at",
    "expires_at",
    "canonical_payload_hash"
  ],
  "title": "TRADE_PROPOSAL_V1",
  "type": "object",
  "x-aic-canonical-hash-field": "canonical_payload_hash",
  "x-aic-canonical-id-field": "proposal_id",
  "x-aic-canonical-name": "TRADE_PROPOSAL_V1",
  "x-aic-contract-version": "0.2",
  "x-aic-field-authority": "MACHINE_CLOSED_V0_2",
  "x-aic-fixed-field-presence": true,
  "x-aic-implementation-rule": "Pydantic implementation MUST conform to this schema; prose is not field authority.",
  "x-aic-journal-payload-schema": "aic.trade_proposal.v1",
  "x-aic-persistence-class": "DURABLE_CANONICAL",
  "x-aic-presence-normalization": "ALL_TOP_LEVEL_FIELDS_PRESENT; SOURCE_OPTIONAL_OR_IF_AVAILABLE_VALUES_ARE_EXPLICIT_NULL",
  "x-aic-self-hash-field": "canonical_payload_hash",
  "x-aic-self-hash-rule": "SHA256(B1_CANONICAL_SERIALIZATION(object excluding own self-hash field only))",
  "x-aic-semantic-validators": [
    {
      "id": "TP-V01",
      "rule": "all economic+lineage fields exact-copy AcceptedProposalCandidate; B6 may create only proposal_id,intent_id,timestamps and canonical hash"
    }
  ],
  "x-aic-source-refs": [
    "P-B5_B6_ACCEPTED_PROPOSAL_HANDOFF_AMENDMENT_v0.5:§5,§11",
    "CANONICAL_MANIFEST_v0.5:M035"
  ]
}
