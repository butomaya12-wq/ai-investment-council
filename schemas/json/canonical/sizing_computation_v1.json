{
  "$id": "urn:aic:b1.2:schema:SIZING_COMPUTATION_V1:v0.4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm_id": {
      "minLength": 1,
      "type": "string"
    },
    "algorithm_version": {
      "minLength": 1,
      "type": "string"
    },
    "calculated_at": {
      "format": "date-time",
      "type": "string",
      "x-aic-require-aware-utc": true
    },
    "candidate_id": {
      "minLength": 1,
      "type": "string"
    },
    "computation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "current_long_exposure": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string",
      "x-aic-no-exponent": true,
      "x-aic-python-type": "decimal.Decimal"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "input_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "notional_usd": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string",
      "x-aic-no-exponent": true,
      "x-aic-python-type": "decimal.Decimal"
    },
    "optional_absolute_base_notional_cap_usd": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string",
          "x-aic-no-exponent": true,
          "x-aic-python-type": "decimal.Decimal"
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_buy_exposure": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string",
      "x-aic-no-exponent": true,
      "x-aic-python-type": "decimal.Decimal"
    },
    "raw_increment": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string",
      "x-aic-no-exponent": true,
      "x-aic-python-type": "decimal.Decimal"
    },
    "risk_input_snapshot_id": {
      "minLength": 1,
      "type": "string"
    },
    "rounding_rule": {
      "minLength": 1,
      "type": "string"
    },
    "sizing_computation_id": {
      "minLength": 1,
      "type": "string"
    },
    "sizing_policy_ref": {
      "$ref": "urn:aic:b1.2:schema:POLICY_REFERENCE_V1:v0.2"
    },
    "target_position_notional": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string",
      "x-aic-no-exponent": true,
      "x-aic-python-type": "decimal.Decimal"
    }
  },
  "required": [
    "sizing_computation_id",
    "candidate_id",
    "risk_input_snapshot_id",
    "sizing_policy_ref",
    "algorithm_id",
    "algorithm_version",
    "input_refs",
    "input_hash",
    "target_position_notional",
    "current_long_exposure",
    "pending_buy_exposure",
    "raw_increment",
    "optional_absolute_base_notional_cap_usd",
    "notional_usd",
    "rounding_rule",
    "calculated_at",
    "computation_hash"
  ],
  "title": "SIZING_COMPUTATION_V1",
  "type": "object",
  "x-aic-canonical-hash-field": "computation_hash",
  "x-aic-canonical-id-field": "sizing_computation_id",
  "x-aic-canonical-name": "SIZING_COMPUTATION_V1",
  "x-aic-contract-version": "0.4",
  "x-aic-field-authority": "MACHINE_CLOSED_V0_4",
  "x-aic-fixed-field-presence": true,
  "x-aic-implementation-rule": "Pydantic/runtime bindings MUST conform to this exact accepted schema resource; prose/candidate self-hashes cannot override the external accepted registry baseline.",
  "x-aic-journal-payload-schema": "aic.sizing_computation.v1",
  "x-aic-normalization-decision-ids": [
    "ND-R5-SIZE-001"
  ],
  "x-aic-persistence-class": "DURABLE_CANONICAL",
  "x-aic-presence-normalization": "ALL_TOP_LEVEL_FIELDS_PRESENT; NULLABILITY_ONLY_WHERE_EXPLICITLY_SOURCE_BACKED_OR_REVIEWED_NORMALIZATION",
  "x-aic-registry-baseline-required": true,
  "x-aic-self-hash-field": "computation_hash",
  "x-aic-self-hash-rule": "SHA256(B1_CANONICAL_SERIALIZATION(object excluding own self-hash field only))",
  "x-aic-semantic-validators": [
    {
      "id": "SIZE4-V01",
      "rule": "Materialized names follow current sizing variables: target_position_notional, current_long_exposure, pending_buy_exposure, raw_increment, optional_absolute_base_notional_cap_usd, notional_usd; no policy value/default is invented."
    }
  ],
  "x-aic-source-refs": [
    "P-B5_RISK_AND_SIZING_POLICY_CONTRACT_v0.2:§1 deterministic algorithm",
    "P-B5_IMPLEMENTATION_PACKET_v0.1:§8 D09 algorithm",
    "CANONICAL_MANIFEST_v0.5:M029"
  ]
}
